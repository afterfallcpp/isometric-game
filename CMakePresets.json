{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows",
            "displayName": "Windows - Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux - Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows",
            "configurePreset": "windows"
        },
        {
            "name": "linux",
            "configurePreset": "linux"
        }
    ],
    "testPresets": [
        {
            "name": "windows",
            "configurePreset": "windows",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}